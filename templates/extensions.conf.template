[general]
static = yes
writeprotect = no

; Исходящий из браузера сотрудника: номер в любом виде → цифры → формат линии (CRM_DIALFMT: 8 | 7 | +7)
[crm-out]
exten => _[+0-9].,1,NoOp(CRM out line \${CRM_LINE} to \${EXTEN})
 same => n,Set(NUM=\${FILTER(0123456789,\${EXTEN})})
 same => n,ExecIf(\$[\${LEN(\${NUM})} = 10]?Set(NUM=7\${NUM}))
 same => n,ExecIf(\$[\${LEN(\${NUM})} = 11 & \"\${NUM:0:1}\" = \"8\"]?Set(NUM=7\${NUM:1}))
 same => n,Set(DIAL=\${NUM})
 same => n,ExecIf(\$[\"\${CRM_DIALFMT}\" = \"8\" & \${LEN(\${NUM})} = 11]?Set(DIAL=8\${NUM:1}))
 same => n,ExecIf(\$[\"\${CRM_DIALFMT}\" = \"+7\" & \${LEN(\${NUM})} = 11]?Set(DIAL=+\${NUM}))
 same => n,Set(CALL_ID=\${UNIQUEID})
 same => n,Set(R=\${CURL(${BACKEND}/crm-internal/asterisk/call?token=${TOKEN}&event=start&dir=out&line=\${CRM_LINE}&phone=\${NUM}&id=\${CALL_ID})})
 same => n,Set(CHANNEL(hangup_handler_push)=crm-hangup,s,1(\${CALL_ID}))
 same => n,MixMonitor(/var/spool/asterisk/monitor/\${CALL_ID}.wav,b)
 same => n,Dial(PJSIP/\${DIAL}@line\${CRM_LINE},90)
 same => n,Hangup()

; Входящий на номер линии → браузер сотрудника этой линии (45 с), иначе — пропущенный
[crm-in]
exten => _X.,1,Goto(crm-in,s,1)
exten => _+X.,1,Goto(crm-in,s,1)
exten => s,1,NoOp(CRM in line \${CRM_LINE} from \${CALLERID(num)})
 same => n,Set(CALL_ID=\${UNIQUEID})
 same => n,Set(NUM=\${FILTER(0123456789,\${CALLERID(num)})})
 same => n,Set(R=\${CURL(${BACKEND}/crm-internal/asterisk/call?token=${TOKEN}&event=start&dir=in&line=\${CRM_LINE}&phone=\${NUM}&id=\${CALL_ID})})
 same => n,Set(CHANNEL(hangup_handler_push)=crm-hangup,s,1(\${CALL_ID}))
 same => n,MixMonitor(/var/spool/asterisk/monitor/\${CALL_ID}.wav,b)
 same => n,Dial(PJSIP/agent\${CRM_LINE},45)
 same => n,Hangup()

; Конец звонка: статус и длительность в CRM, запись — загрузчиком в фоне
[crm-hangup]
exten => s,1,NoOp(CRM hangup \${ARG1} \${DIALSTATUS} \${ANSWEREDTIME})
 same => n,Set(BILLSEC=\${IF(\$[\"\${ANSWEREDTIME}\" = \"\"]?0:\${ANSWEREDTIME})})
 same => n,Set(R=\${CURL(${BACKEND}/crm-internal/asterisk/call?token=${TOKEN}&event=end&id=\${ARG1}&status=\${DIALSTATUS}&billsec=\${BILLSEC})})
 same => n,System(/usr/local/bin/crm-upload.sh \${ARG1} &)
 same => n,Return()
